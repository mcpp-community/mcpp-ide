    { "file": "build-manifest-error.ndjson", "each": "buildStreamLine" },
    { "file": "result-ok.json", "schema": "resultRecord" },
    { "file": "launch.json", "schema": "launchEnvelope" },
    { "file": "test.ndjson", "each": "testStreamLine" },
    { "file": "test-list.ndjson", "each": "testListLine" },
    { "file": "build-database.json", "schema": "buildDatabaseEnvelope" },
    { "file": "toolchain-list.json", "schema": "toolchainListEnvelope" },
    { "file": "search.json", "schema": "searchEnvelope" },
    { "file": "cache-list.json", "schema": "cacheListEnvelope" },
    { "file": "index-list.json", "schema": "indexListEnvelope" },
    { "file": "pack-formats.json", "schema": "packFormatsEnvelope" },
    { "file": "self-env.json", "schema": "selfEnvEnvelope" },
    { "file": "build-platform.ndjson", "each": "buildStreamLine", "optional": true },
    { "file": "toolchain-list-platform.json", "schema": "toolchainListEnvelope", "optional": true }
