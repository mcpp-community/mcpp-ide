    Translation{"Searching other registries…", "正在搜索其它 registry…"},
    Translation{"Select a node to explore its relationships.", "选择节点查看关联。"},
    Translation{"Select an mcpp project before adding this library.", "请先选择 mcpp 项目，再添加此库。"},
    Translation{"Select analysis context", "重选分析上下文"},
    Translation{"Select the global default toolchain", "选择全局默认工具链"},
    Translation{"Selected", "选中"},
    Translation{"Selected node", "已选节点"},
    Translation{"SemVer version dependency", "SemVer 版本依赖"},
    Translation{"Set as global default", "设为全局默认"},
    Translation{"Set index path", "设置索引路径"},
    Translation{"Set the global default toolchain", "设置全局默认工具链"},
    Translation{"Setting the global default toolchain failed (exit code {0}). See the mcpp output channel.", "设置全局默认工具链失败（退出码 {0}）。请查看 mcpp 输出频道。"},
    Translation{"Settings", "设置"},
    Translation{"Settings and diagnostics", "设置与诊断"},
    Translation{"Share of the total cache size, by entry kind.", "按条目类型占缓存总大小的比例。"},
    Translation{"Shared build cache", "共享构建缓存"},
    Translation{"Show advanced settings", "显示高级设置"},
    Translation{"Show cache entry details for {0}", "查看缓存条目 {0} 的详情"},
    Translation{"Show output", "查看输出"},
    Translation{"Show running tasks", "显示正在运行的任务"},
    Translation{"Show toolchains", "查看工具链"},
    Translation{"Simulates mcpp cache gc --max-size: the estimate is a local projection, so mcpp's own policy decides in the end.", "模拟 mcpp cache gc --max-size：这里的估算只是本地推算，最终仍以 mcpp 自身的策略为准。"},
    Translation{"Size", "大小"},
    Translation{"Source", "源码"},
    Translation{"Source and diagnostics", "来源与诊断"},
    Translation{"Source dependency", "源码依赖"},
    Translation{"Source details", "来源详情"},
    Translation{"Source is unavailable for this module.", "此模块的源码不可用。"},
    Translation{"Stale artifacts: about {0}", "其中过期产物约 {0}"},
    Translation{"Standard", "标准"},
    Translation{"Switch to {0}", "切换到 {0}"},
    Translation{"System toolchain (mcpp only detects it)", "系统工具链（mcpp 只检测）"},
    Translation{"System: system toolchain, detection only", "System：系统工具链，仅检测"},
    Translation{"Table form: contributes the package's own macros when activated", "表形式：激活时贡献包自有宏"},
    Translation{"Table form: feature-gated source globs", "表形式：feature 门控的源 glob"},
    Translation{"Table form: requires a capability", "表形式：需要 capability"},
    Translation{"Takes effect on the next build", "下次构建时生效"},
    Translation{"Takes effect on the next clean", "下次清理时生效"},
    Translation{"Target", "目标"},
    Translation{"Target project", "目标项目"},
    Translation{"Targets", "目标"},
    Translation{"Task arguments: {0}", "任务参数：{0}"},
    Translation{"Test", "测试"},
    Translation{"Tests", "测试"},
    Translation{"The C++ Modules extension ({0}) is not installed or is disabled.", "C++ Modules 扩展（{0}）未安装或已禁用。"},
    Translation{"The build was cancelled; the C++ Modules language service was not refreshed.", "构建已取消；C++ 模块语言服务未刷新。"},
    Translation{"The compatible spec {0} carrying target semantics is handed to mcpp to install.", "将把携带 target 语义的兼容 spec {0} 交给 mcpp 安装。"},
    Translation{"The compatible spec {0}, which may carry target semantics, is handed to mcpp to install, and mcpp validates it in the end.", "将把可能携带 target 语义的兼容 spec {0} 交给 mcpp 安装，最终由 mcpp 校验。"},
    Translation{"The current environment platform is not recognized by this index.", "索引无法识别当前环境平台。"},
    Translation{"The current mcpp toolchain list output is not recognised; the raw output is kept in the mcpp output channel, so check the mcpp version.", "无法识别当前 mcpp toolchain list 输出；原始输出已保留在 mcpp 输出频道，请检查 mcpp 版本。"},
    Translation{"The dependency declaration changed. Review mcpp.toml before adding it.", "依赖声明已变化，请先检查 mcpp.toml 再添加。"},
    Translation{"The destination already exists: {0}. Choose another project name or location.", "目标路径已存在：{0}。请更换项目名或位置。"},
    Translation{"The global default pair is set to {0} + host target. The mcpp.toml/target configuration of the current project can still override it.", "将把全局默认对设为 {0} + host target。当前项目的 mcpp.toml/target 配置仍可能覆盖它。"},
    Translation{"The index folders contain no descriptors.", "索引目录里没有描述符。"},
    Translation{"The installation may download a large toolchain package and modifies the mcpp global cache.", "安装可能下载较大的工具链包，并修改 mcpp 全局缓存。"},
    Translation{"The mcpp build failed (exit code {0}); the C++ Modules language service re-read the existing build description.", "mcpp 构建失败（退出码 {0}）；C++ 模块语言服务已重新读取现有构建描述。"},
    Translation{"The mcpp build finished; the C++ Modules language service has been refreshed.", "mcpp 构建完成，C++ 模块语言服务已刷新。"},
    Translation{"The mcpp global default is now {0} + host target. Cleaning the old toolchain artifacts and rebuilding is recommended.", "mcpp 全局默认已更新为 {0} + host target。建议清理旧工具链产物后重新构建。"},
    Translation{"The package descriptor is missing. Reread the local index.", "包描述不存在，请重新读取本地索引。"},
    Translation{"The program did not build; see the task terminal for the compiler output.", "程序未构建成功；编译器输出见任务终端。"},
    Translation{"The project currently overrides the global default; this only changes the current mcpp global configuration", "项目当前覆盖全局默认；这里只修改 mcpp 当前全局配置"},
    Translation{"The project manifest is missing or unreadable.", "项目清单不存在或无法读取。"},
    Translation{"The project name must not be . or ..", "项目名不能是 . 或 .."},
    Translation{"The project name must not be a Windows reserved device name.", "项目名不能是 Windows 保留设备名"},
    Translation{"The project name must not be empty.", "项目名不能为空"},
    Translation{"The project name must not contain PROJECT: it triggers a defect in the current mcpp template substitution.", "项目名不能包含 PROJECT，否则会触发当前 mcpp 模板替换缺陷"},
    Translation{"The project name must not contain a path separator.", "项目名不能包含路径分隔符"},
    Translation{"The project name must not contain control characters.", "项目名不能包含控制字符"},
    Translation{"The project name must not end with . (unsupported on Windows).", "项目名不能以 . 结尾（Windows 不支持）"},
    Translation{"The project name must not start with -, or mcpp would read it as a command-line option.", "项目名不能以 - 开头，否则会被 mcpp 解析为命令行选项"},
    Translation{"The project root sits below the VS Code folder; the real build resolution is whatever mcpp reports", "当前工程根位于 VS Code 文件夹子目录；实际构建解析以 mcpp 为准"},
    Translation{"The same figures are listed as text next to each bar.", "每个条形图旁边以文字列出了同样的数字。"},
    Translation{"The setting could not be written; the toggle was not saved.", "设置写入失败；开关没有保存。"},
    Translation{"The shared build cache could not be read.", "无法读取共享构建缓存。"},
    Translation{"The shared build cache is not available.", "共享构建缓存不可用。"},
    Translation{"The shared build cache is {0}, at or above the {1} warning threshold.", "共享构建缓存为 {0}，已达到或超过 {1} 的告警阈值。"},
    Translation{"The shared build cache is {0}. Raise or clear mcpp.cache.warnAboveGiB to change when this appears.", "共享构建缓存为 {0}。调高或清空 mcpp.cache.warnAboveGiB 可改变告警时机。"},
    Translation{"The source graph is incomplete. Refresh after indexing finishes.", "数据尚不完整，可在索引完成后刷新。"},
    Translation{"The source graph is incomplete. Some modules may be omitted.", "源图数据不完整，部分模块可能尚未包含。"},
    Translation{"The target axis is shown read-only; to select a target use the mcpp CLI", "target 轴只读展示；选择 target 请使用 mcpp CLI"},
    Translation{"The version is required: mcpp accepts an exact version only.", "必须指定版本：mcpp 只接受精确版本。"},
    Translation{"The workspace is not trusted; mcpp itself was not probed.", "工作区未受信任；未探测 mcpp 本身。"},
    Translation{"The workspace is not trusted; the other registries were not searched.", "工作区未受信任；未搜索其他 registry。"},
    Translation{"The {0} largest cache labels, by bytes.", "按字节数排名的前 {0} 个缓存标签。"},
    Translation{"There is no pre-v1 cache to remove.", "没有可清理的 pre-v1 缓存。"},
    Translation{"They answer the same C++ files, so results appear twice. Click to turn their C++ language features off; C++ Modules asks whether for this workspace or everywhere.", "它们也在处理同一批 C++ 文件，结果会出现两次。点击即可关闭它们的 C++ 语言功能；C++ Modules 会询问只对本工作区还是对所有地方生效。"},
    Translation{"This dependency name is ambiguous. Use a qualified package name in mcpp.toml.", "此依赖名称有歧义，请在 mcpp.toml 中使用完整包名。"},
    Translation{"This descriptor declares no dependencies.", "此描述符没有声明依赖。"},
    Translation{"This does not clean the global BMI cache.", "此操作不会清理全局 BMI 缓存。"},
    Translation{"This index publishes no version for any platform.", "此索引没有为任何平台发布版本。"},
    Translation{"This index publishes no version for this platform, so there is nothing to add.", "此索引没有为当前平台发布版本，因此无法添加。"},
    Translation{"This is a search preview. Set an index path containing this package to read its complete details.", "这是搜索预览。将索引路径设置为包含此包的目录后，可读取完整详情。"},
    Translation{"This is the current-directory view; overrides from the project or a parent configuration are decided by the actual build", "当前目录视图；项目或父级配置的覆盖以实际构建为准"},
    Translation{"This is the current-directory view; the value mcpp build resolves is authoritative", "当前目录视图；实际生效值以 mcpp build 解析为准"},
    Translation{"This mcpp build does not recognise that command; update mcpp or check the spelling.", "此 mcpp 版本不认识该命令；请升级 mcpp 或检查拼写。"},
    Translation{"This package has no test project in the index, so there is no example to show.", "此包在索引里没有示例工程，因此没有示例可显示。"},
    Translation{"This package is not in the local index any more.", "此包已不在本地索引中。"},
    Translation{"This panel changes mcpp-vscode settings only; the C++ Modules extension ({0}) keeps its own mcppls.* settings and this panel never writes them.", "本面板只修改 mcpp-vscode 的设置；C++ Modules 扩展（{0}）自行管理其 mcppls.* 设置，本面板不会写入它们。"},
    Translation{"This project declares no dependencies", "此项目未声明依赖"},
    Translation{"This project may not be using this value", "当前项目可能没有使用此值"},
    Translation{"This project uses a source dependency. Edit its manifest to change the source.", "项目已声明源码依赖，请编辑清单修改来源。"},
    Translation{"This runs mcpp build and has the C++ Modules extension re-read the build description; it does not change the toolchain, mcpp.toml or any language service setting.", "将执行 mcpp build，并由 C++ Modules 扩展重新读取构建描述；不会修改工具链、mcpp.toml 或任何语言服务设置。"},
    Translation{"This workspace has no mcpp.toml.", "当前工作区没有找到 mcpp.toml。"},
    Translation{"This workspace is not trusted, so mcpp is not run; the versions below come from the descriptor's text.", "工作区未受信任，因此不运行 mcpp；下面的版本来自描述符文本。"},
    Translation{"This workspace is not trusted, so mcpp will not run and the C++ Modules language service will not refresh. Trust the workspace first.", "当前工作区未受信任，不会执行 mcpp 或刷新 C++ 模块语言服务。请先信任工作区。"},
    Translation{"This workspace is not trusted. mcpp commands may run external programs named by workspace settings; trust the workspace first.", "当前工作区未受信任。mcpp 命令可能执行工作区设置指定的外部程序，请先信任工作区。"},
    Translation{"This workspace is not trusted. mcpp commands that write are disabled until you trust it.", "当前工作区未受信任。会写盘的 mcpp 命令在信任工作区之前不会执行。"},
    Translation{"This {0} GiB budget frees entries that every mcpp project on this machine shares. The cleanup can take a while, and any dropped entry is rebuilt on next use.", "{0} GiB 的预算会释放本机所有 mcpp 工程共享的条目。清理可能耗时，被丢弃的条目会在下次使用时重建。"},
    Translation{"Toggle this section", "折叠或展开本节"},
    Translation{"Toolchain", "工具链"},
    Translation{"Toolchain managed by mcpp", "mcpp 管理的工具链"},
    Translation{"Toolchain {0} installed. Choose a global default from the latest list?", "工具链 {0} 安装完成。是否从最新列表中选择全局默认？"},
    Translation{"Trust this workspace to run mcpp and add dependencies.", "信任此工作区后，才能运行 mcpp 和添加依赖。"},
    Translation{"Unavailable", "暂无元数据"},
    Translation{"Unexpected error: {0}", "发生未预期错误：{0}"},
    Translation{"Unknown", "未知"},
    Translation{"Up to 3 dependency levels · {0} packages · {1} edges", "最多 3 层依赖 · {0} 个包 · {1} 条关系"},
    Translation{"Update mcpp index", "更新 mcpp 索引"},
    Translation{"Updating mcpp index…", "正在更新 mcpp 索引…"},
    Translation{"Updating the global mcpp index; a configured custom checkout is only reread.", "正在更新全局 mcpp 索引；已配置的自定义检出目录仅会被重新读取。"},
    Translation{"Usage", "用法"},
    Translation{"Use", "用法"},
    Translation{"User", "用户"},
    Translation{"User settings", "用户设置"},
    Translation{"VS Code could not open {0}. The link is on your clipboard.", "VS Code 无法打开 {0}，链接已复制到剪贴板。"},
    Translation{"Values shown for {0}", "以下值适用于 {0}"},
    Translation{"Verify the cache", "校验缓存"},
    Translation{"Verify the shared cache", "校验共享缓存"},
    Translation{"Version", "版本"},
    Translation{"Version availability could not be confirmed. Retry reading this descriptor.", "暂时无法确认版本可用性，请重新读取包描述。"},
    Translation{"Versions", "版本"},
    Translation{"Versions ({0})", "版本（{0}）"},
    Translation{"Versions are from descriptor text; mcpp will confirm availability when adding.", "版本来自描述符文本，添加时将由 mcpp 确认可用性。"},
    Translation{"Versions mcpp aggregates by family; this operation installs for the host target", "mcpp 按 family 聚合的可用版本；本操作按 host target 安装"},
    Translation{"View limit reached. Focus a node to explore its dependencies.", "已达到当前视图上限，可聚焦节点继续查看。"},
    Translation{"View options", "视图"},
    Translation{"What the descriptor declares. The resolved version lives in a project's mcpp.lock, not here.", "这里显示描述符声明的依赖。解析后的版本在工程的 mcpp.lock 里，不在这里。"},
    Translation{"Working directory: {0}", "工作目录：{0}"},
    Translation{"Workspace", "工作区"},
    Translation{"Workspace folder", "工作区文件夹"},
    Translation{"Workspace member declarations", "工作空间成员声明"},
    Translation{"Workspace settings", "工作区设置"},
    Translation{"Zoom in", "放大"},
    Translation{"Zoom out", "缩小"},
    Translation{"added", "已添加"},
    Translation{"build", "构建"},
    Translation{"conditional", "条件"},
    Translation{"convention {0}", "约定 {0}"},
    Translation{"dev dependency", "dev 依赖"},
    Translation{"git · {0}", "git · {0}"},
    Translation{"host default", "host 默认"},
    Translation{"index", "索引"},
    Translation{"latest {0}", "最新 {0}"},
    Translation{"mcpp CLI operation failed: {0}", "mcpp CLI 操作失败：{0}"},
    Translation{"mcpp Package Index refreshed: {0} package(s) from {1} index folder(s).", "mcpp 包索引已刷新：{0} 个包，来自 {1} 个索引目录。"},
    Translation{"mcpp add failed (exit {0}). See output for details.", "mcpp add 失败（退出码 {0}），请查看输出了解详情。"},
    Translation{"mcpp add failed with exit code {0}.", "mcpp add 失败，退出码 {0}。"},
    Translation{"mcpp add failed with exit code {0}: {1}", "mcpp add 失败，退出码 {0}：{1}"},
    Translation{"mcpp add needs an exact version: mcpp add {0}@<version>.", "mcpp add 需要精确版本：mcpp add {0}@<version>。"},
    Translation{"mcpp add {0}@{1}", "mcpp add {0}@{1}"},
    Translation{"mcpp add {0}@{1} --dev", "mcpp add {0}@{1} --dev"},
    Translation{"mcpp also clears the global default_target; the configuration file location is decided by the current mcpp installation and MCPP_HOME.", "mcpp 会同时清空全局 default_target；配置文件位置由当前 mcpp 安装及 MCPP_HOME 决定。"},
    Translation{"mcpp build was not started.", "未启动 mcpp 构建。"},
    Translation{"mcpp cache list did not return the documented document", "mcpp cache list 未返回约定的文档"},
    Translation{"mcpp cache list failed (exit {0})", "mcpp cache list 失败（退出码 {0}）"},
    Translation{"mcpp cache verify failed with exit code {0}", "mcpp cache verify 失败，退出码 {0}"},
    Translation{"mcpp clean --dry-run", "mcpp clean --dry-run"},
    Translation{"mcpp decides whether the compiler prefix is a valid triple; when it is, it may download a larger toolchain package for that target.", "mcpp 会判断编译器前缀是否为有效 triple；有效时可能下载对应 target 的较大工具链包。"},
    Translation{"mcpp does not download or install MSVC; it detects Visual Studio and points to the official installation guide when it is missing.", "mcpp 不会下载或安装 MSVC；它会检测 Visual Studio，并在缺失时给出官方安装指引。"},
    Translation{"mcpp finished {0}. This first release does not change the target default; to set one, use the mcpp CLI with --target.", "mcpp 已完成 {0}。首版插件不修改 target 默认；如需设为默认，请使用带 --target 的 mcpp CLI。"},
    Translation{"mcpp global configuration", "mcpp 全局配置"},
    Translation{"mcpp has no global default toolchain yet", "mcpp 尚未设置全局默认工具链"},
    Translation{"mcpp index update failed with exit code {0}", "mcpp index update 失败，退出码 {0}"},
    Translation{"mcpp is installed but the environment is not ready; run `mcpp self doctor` to see what is missing.", "mcpp 已安装但环境尚未就绪；运行 `mcpp self doctor` 查看缺少什么。"},
    Translation{"mcpp library ecosystem", "mcpp 库生态"},
    Translation{"mcpp list item effective for this directory; the actual build resolution may be affected by a parent mcpp workspace", "mcpp list 当前目录有效项；实际构建解析可能受父级 mcpp 工作区影响"},
    Translation{"mcpp list toolchain for this directory", "mcpp list 当前目录工具链"},
    Translation{"mcpp listed no usable toolchain; see the raw result in the mcpp output channel.", "mcpp 没有列出可用工具链；请查看 mcpp 输出频道中的原始结果。"},
    Translation{"mcpp new {0} failed (exit code {1}). See the mcpp output channel.", "mcpp new {0} 失败（退出码 {1}）。请查看 mcpp 输出频道。"},
    Translation{"mcpp normalises the compatible spelling and may download a larger toolchain package for that target.", "mcpp 会规范化兼容写法，并可能下载对应 target 的较大工具链包。"},
    Translation{"mcpp pack packaging configuration", "mcpp pack 打包配置"},
    Translation{"mcpp rejected the command line; check the arguments and run it from the project root.", "mcpp 拒绝了命令行；请检查参数，并在工程根目录运行。"},
    Translation{"mcpp reported an internal error; re-run with the mcpp output channel open and report it.", "mcpp 报告了内部错误；请打开 mcpp 输出频道重跑并反馈。"},
    Translation{"mcpp settings", "mcpp 设置"},
    Translation{"mcpp toolchain list failed (exit code {0}). See the mcpp output channel.", "mcpp toolchain list 失败（退出码 {0}）。请查看 mcpp 输出频道。"},
    Translation{"mcpp toolchain management", "mcpp 工具链管理"},
    Translation{"mcpp toolchain {0} is installed (no target specified, the host target is used).", "将安装 mcpp 工具链 {0}（不指定 target，使用 host target）。"},
    Translation{"mcpp toolchains and targets", "mcpp 工具链与 target"},
    Translation{"mcpp will detect the system MSVC ({0}).", "将调用 mcpp 检测系统 MSVC（{0}）。"},
    Translation{"mcpp xpkg parse could not read this descriptor; the versions below come from its text, which is less authoritative.", "mcpp xpkg parse 无法读取此描述符；下面的版本来自文本解析，权威性较低。"},
    Translation{"mcpp {0} failed with exit code {1}", "mcpp {0} 失败，退出码 {1}"},
    Translation{"mcpp.toml could not be read", "无法读取 mcpp.toml"},
    Translation{"mcpp: Build", "mcpp: 构建"},
    Translation{"mcpp: Clean", "mcpp: 清理"},
    Translation{"mcpp: Run", "mcpp: 运行"},
    Translation{"mcpp: Test", "mcpp: 测试"},
    Translation{"mcpp: detect system MSVC ({0})", "mcpp: 检测系统 MSVC（{0}）"},
    Translation{"mcpp: install toolchain {0}", "mcpp: 安装工具链 {0}"},
    Translation{"mcpp: moved {0} setting(s).", "mcpp：已移动 {0} 个设置。"},
    Translation{"mcpp: quick menu", "mcpp: 快捷菜单"},
    Translation{"mcpp: {0}", "mcpp：{0}"},
    Translation{"mcppls {0}", "mcppls {0}"},
    Translation{"more than {0} day(s)", "超过 {0} 天"},
    Translation{"more than {0} day(s) ago", "超过 {0} 天前"},
    Translation{"not read yet", "尚未读取"},
    Translation{"openkal-compat", "openkal-compat"},
    Translation{"openkal-ecosystem", "openkal-ecosystem"},
    Translation{"other registry", "其它 registry"},
    Translation{"path · {0}", "路径 · {0}"},
    Translation{"resolved {0}", "已解析 {0}"},
    Translation{"the workspace is not trusted", "工作区未受信任"},
    Translation{"this platform", "当前平台"},
    Translation{"under {0} day(s)", "少于 {0} 天"},
    Translation{"unknown", "未知"},
    Translation{"unknown error", "未知错误"},
    Translation{"upstream mcpp.toml", "上游 mcpp.toml"},
    Translation{"uses platform interfaces", "使用平台接口"},
    Translation{"{0}", "{0}"},
    Translation{"{0} cache entries are incomplete; run mcpp cache verify to see which ones.", "有 {0} 个缓存条目不完整；运行 mcpp cache verify 可查看具体是哪些。"},
    Translation{"{0} descriptor(s) from {1} local index folder(s): {2}. Read offline.", "从 {1} 个本地索引目录读到 {0} 个描述符：{2}。离线读取。"},
    Translation{"{0} dev", "{0} 个 dev"},
