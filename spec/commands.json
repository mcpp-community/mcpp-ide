{
  "version": 1,
  "groups": [
    { "id": "project", "title": "group.project" },
    { "id": "cache", "title": "group.cache" },
    { "id": "library", "title": "group.library" },
    { "id": "toolchain", "title": "group.toolchain" },
    { "id": "languageService", "title": "group.languageService" },
    { "id": "tools", "title": "group.tools" }
  ],
  "commands": [
    { "id": "mcpp.build", "group": "project", "icon": { "jetbrains": "AllIcons.Actions.Compile" },
      "when": "mcpp.inProject", "keybinding": { "key": "ctrl+alt+b", "mac": "cmd+alt+b" },
      "action": { "kind": "job", "job": "build" }, "quickMenu": true },
    { "id": "mcpp.run", "group": "project", "icon": { "vscode": "$(play)", "jetbrains": "AllIcons.Actions.Execute" },
      "when": "mcpp.inProject", "keybinding": { "key": "ctrl+alt+r", "mac": "cmd+alt+r" },
      "menus": [ { "menu": "editor/title", "group": "navigation@1", "when": "mcpp.inProject && mcpp.editorTitleButtons" } ],
      "action": { "kind": "run" }, "quickMenu": true },
    { "id": "mcpp.debug", "paletteWhen": "mcpp.inProject", "group": "project", "icon": { "vscode": "$(debug-alt)", "jetbrains": "AllIcons.Actions.StartDebugger" },
      "when": "mcpp.inProject", "action": { "kind": "debug" }, "quickMenu": true },
    { "id": "mcpp.test", "group": "project", "icon": { "vscode": "$(beaker)", "jetbrains": "AllIcons.RunConfigurations.TestState.Run" },
      "when": "mcpp.inProject", "keybinding": { "key": "ctrl+alt+t", "mac": "cmd+alt+t" },
      "menus": [ { "menu": "editor/title", "group": "navigation@2", "when": "mcpp.inProject && mcpp.editorTitleButtons" } ],
      "action": { "kind": "job", "job": "test" }, "quickMenu": true },
    { "id": "mcpp.clean", "group": "project", "icon": { "jetbrains": "AllIcons.Actions.GC" },
      "when": "mcpp.inProject", "action": { "kind": "cache", "plan": "project" }, "quickMenu": true },
    { "id": "mcpp.pack", "paletteWhen": "mcpp.inProject", "group": "project", "icon": { "vscode": "$(package)", "jetbrains": "AllIcons.Nodes.PpLib" },
      "when": "mcpp.inProject", "action": { "kind": "panel", "panel": "pack" }, "quickMenu": true },
    { "id": "mcpp.cancelJob", "paletteWhen": "mcpp.jobRunning", "group": "project", "icon": { "vscode": "$(debug-stop)", "jetbrains": "AllIcons.Actions.Suspend" },
      "when": "mcpp.jobRunning", "subcommand": "cancel", "action": { "kind": "cancel" } },
    { "id": "mcpp.problems", "group": "project", "editors": [ "nvim" ], "action": { "kind": "problems" }, "quickMenu": true },
    { "id": "mcpp.selectTarget", "group": "toolchain", "icon": { "vscode": "$(target)", "jetbrains": "AllIcons.General.Gear" },
      "action": { "kind": "selectTarget" }, "quickMenu": true },
    { "id": "mcpp.showTargets", "group": "toolchain", "icon": { "vscode": "$(server-environment)", "jetbrains": "AllIcons.Nodes.Deploy" },
      "action": { "kind": "panel", "panel": "targets" }, "quickMenu": true },
    { "id": "mcpp.showToolchains", "group": "toolchain", "action": { "kind": "panel", "panel": "targets" } },
    { "id": "mcpp.installToolchain", "group": "toolchain", "action": { "kind": "installToolchain" } },
    { "id": "mcpp.selectDefaultToolchain", "group": "toolchain", "action": { "kind": "selectDefaultToolchain" } },
    { "id": "mcpp.newProject", "group": "project", "icon": { "jetbrains": "AllIcons.Actions.NewFolder" },
      "action": { "kind": "newProject" }, "quickMenu": true },
    { "id": "mcpp.showMenu", "group": "tools",
      "when": "mcpp.inProject", "keybinding": { "key": "ctrl+alt+m", "mac": "cmd+alt+m" },
      "action": { "kind": "quickMenu" }, "editors": [ "vscode", "nvim" ] },
    { "id": "mcpp.openSettings", "group": "tools", "icon": { "jetbrains": "AllIcons.General.Settings" },
      "action": { "kind": "panel", "panel": "settings" }, "quickMenu": true, "editors": [ "vscode", "jetbrains", "cli" ],
      "omitted": { "nvim": "Neovim's settings are setup()'s `settings` table, which the backend validates; no panel edits them." } },
    { "id": "mcpp.selfCheck", "group": "tools", "icon": { "jetbrains": "AllIcons.Actions.Checked" },
      "action": { "kind": "selfCheck" }, "quickMenu": true },
    { "id": "mcpp.autoConfigureModules", "group": "languageService", "action": { "kind": "job", "job": "build", "then": "languageService" } },
    { "id": "mcpp.refreshCompilationDatabase", "group": "languageService", "action": { "kind": "job", "job": "build" } },

    { "id": "mcpp.refreshCacheStats", "group": "cache", "icon": { "jetbrains": "AllIcons.Actions.Refresh" },
      "menus": [ { "menu": "view/title", "group": "navigation@2", "when": "view == mcpp.cache" } ],
      "action": { "kind": "panel", "panel": "cache", "refresh": true } },
    { "id": "mcpp.showCachePanel", "group": "cache", "action": { "kind": "panel", "panel": "cache" }, "quickMenu": true },
    { "id": "mcpp.showCacheEntry", "group": "cache", "action": { "kind": "panel", "panel": "cache" },
      "editors": [ "vscode", "jetbrains", "cli" ], "omitted": { "nvim": "An entry of the cache panel, opened from that panel; Neovim's cache view is text (mcpp.showCachePanel)." } },
    { "id": "mcpp.cleanStaleArtifacts", "group": "cache", "action": { "kind": "cache", "plan": "stale" } },
    { "id": "mcpp.cleanProjectArtifacts", "group": "cache", "when": "mcpp.inProject",
      "keybinding": { "key": "ctrl+alt+l", "mac": "cmd+alt+l" }, "action": { "kind": "cache", "plan": "project" } },
    { "id": "mcpp.gcGlobalCache", "group": "cache", "action": { "kind": "cache", "plan": "cacheGc" } },
    { "id": "mcpp.pruneGlobalCache", "group": "cache", "action": { "kind": "cache", "plan": "cachePrune" } },
    { "id": "mcpp.verifyGlobalCache", "group": "cache", "action": { "kind": "cache", "plan": "cacheVerify" } },
    { "id": "mcpp.cleanLegacyCache", "group": "cache", "action": { "kind": "cache", "plan": "cacheLegacy" } },

    { "id": "mcpp.library.search", "group": "library", "icon": { "vscode": "$(cloud-download)", "jetbrains": "AllIcons.Actions.Find" },
      "action": { "kind": "panel", "panel": "libraries" }, "quickMenu": true },
    { "id": "mcpp.library.openDetail", "group": "library", "action": { "kind": "panel", "panel": "library" },
      "editors": [ "vscode", "jetbrains", "cli" ], "omitted": { "nvim": "A package of the libraries panel, opened from that panel; in Neovim mcpp.library.search lists the packages and adds the one chosen." } },
    { "id": "mcpp.library.updateIndex", "group": "library", "icon": { "vscode": "$(cloud-download)", "jetbrains": "AllIcons.Actions.Download" },
      "menus": [ { "menu": "view/title", "group": "navigation@2", "when": "view == mcpp.library" } ],
      "action": { "kind": "rpc", "method": "library/updateIndex" } },
    { "id": "mcpp.project.showDependencyGraph", "group": "project", "icon": { "vscode": "$(type-hierarchy)", "jetbrains": "AllIcons.Graph.Layout" },
      "menus": [ { "menu": "view/item/context", "group": "inline@1", "when": "view == mcpp.project && viewItem == mcppProjectDependencies" } ],
      "action": { "kind": "panel", "panel": "graph", "graph": "packages" }, "quickMenu": true },
    { "id": "mcpp.project.showModuleDependencyGraph", "group": "project",
      "action": { "kind": "panel", "panel": "graph", "graph": "modules" }, "quickMenu": true },

    { "id": "mcpp.languageServer.refreshState", "group": "languageService", "action": { "kind": "languageService" } },
    { "id": "mcpp.openMcpplsSettings", "group": "languageService", "palette": false, "editors": [ "vscode" ],
      "action": { "kind": "editor", "vscode": "workbench.action.openSettings", "args": [ "@ext:sunrisepeak.mcpp-language-server" ] } },
    { "id": "mcpp.languageServer.restart", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.restartServer" ] } },
    { "id": "mcpp.languageServer.restartEngine", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.restartClangd" ] } },
    { "id": "mcpp.languageServer.resetWorkspaceCache", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.resetWorkspaceCache" ] } },
    { "id": "mcpp.languageServer.selectContext", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.selectContext" ] } },
    { "id": "mcpp.languageServer.showModuleGraph", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.showModuleGraph" ] } },
    { "id": "mcpp.languageServer.showLogs", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.showLogs" ] } },
    { "id": "mcpp.languageServer.collectReport", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.collectReport" ] } },
    { "id": "mcpp.languageServer.exportDiagnosticBundle", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.exportDiagnosticBundle" ] } },
    { "id": "mcpp.languageServer.revealBundle", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.revealCacheDirectory" ] } },
    { "id": "mcpp.languageServer.openLogFolder", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.revealCacheDirectory" ] } },
    { "id": "mcpp.languageServer.runBuildToolInTerminal", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.runBuildToolInTerminal" ] } },
    { "id": "mcpp.languageServer.manageConflicts", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.turnOffOtherCppFeatures" ] } },
    { "id": "mcpp.languageServer.restoreConflicts", "group": "languageService",
      "menus": [ { "menu": "view/item/context", "when": "view == mcpp.project && viewItem =~ /^mcppOtherCppFeatures.*Restorable$/" } ],
      "action": { "kind": "forward", "commands": [ "mcppls.restoreOtherCppFeatures" ] } },
    { "id": "mcpp.languageServer.toggleInWorkspace", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.turnOffInWorkspace", "mcppls.turnOnInWorkspace" ] } },
    { "id": "mcpp.languageServer.installTools", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.installCommandLineTools" ] } },
    { "id": "mcpp.languageServer.reviewChanges", "group": "languageService", "action": { "kind": "forward", "commands": [ "mcppls.review.run" ] } },
    { "id": "mcpp.configureLanguageServer", "group": "languageService", "deprecated": true, "action": { "kind": "forward", "commands": [ "mcppls.selectContext" ] } },
    { "id": "mcpp.configureClangd", "group": "languageService", "deprecated": true, "action": { "kind": "forward", "commands": [ "mcppls.selectContext" ] } },
    { "id": "mcpp.checkModuleSupport", "group": "languageService", "deprecated": true, "action": { "kind": "forward", "commands": [ "mcppls.restartServer" ] } },
    { "id": "mcpp.showModuleGraph", "group": "languageService", "deprecated": true, "action": { "kind": "forward", "commands": [ "mcppls.showModuleGraph" ] } },
    { "id": "mcpp.showLanguageServerLogs", "group": "languageService", "deprecated": true, "action": { "kind": "forward", "commands": [ "mcppls.showLogs" ] } }
  ]
}
