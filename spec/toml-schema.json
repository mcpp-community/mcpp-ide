      "deprecatedBy": null,
      "keys": [
        {
          "key": "driver",
          "type": "enum",
          "values": [
            "compiler",
            "lld"
          ],
          "since": "2026.10.27.1",
          "note": "\"compiler\": the compiler driver links; \"lld\": ld.lld itself links, with flags"
        },
        {
          "key": "exe",
          "type": "string",
          "since": "2026.10.27.1",
          "note": "an executable's name: \"{name}<suffix>\", e.g. \"{name}.oke\""
        },
