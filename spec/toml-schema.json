    {
      "header": "[build]",
      "name": "build",
      "plane": "compile",
      "doc": "https://github.com/mcpp-community/mcpp/blob/main/docs/04-mcpp-toml.md#23-build--build-configuration",
      "deprecatedBy": null,
      "keys": [
        {
          "key": "accel",
          "type": "string",
          "note": "which device backends/architectures this build targets"
        },
        {
          "key": "allow_host_libs",
          "type": "boolean"
        },
        {
          "key": "bmi_schedule",
          "type": "enum",
          "values": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "note": "module-edge scheduling; \"auto\" currently means off"
        },
        {
          "key": "build_program_timeout",
          "type": "number",
          "default": 600,
          "note": "seconds a build.mcpp may run; 0 = no limit"
        },
        {
          "key": "c_standard",
          "type": "string",
          "default": "c11"
        },
        {
          "key": "cache",
          "type": "enum",
