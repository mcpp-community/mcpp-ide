    {
      "header": "[platform]",
      "name": "platform",
      "plane": "platform",
      "doc": "https://github.com/mcpp-community/mcpp/blob/main/docs/35-platforms.md#what-a-platform-states",
      "deprecatedBy": null,
      "keys": [
        {
          "key": "build",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "cflags, cxxflags, asmflags, ldflags, and cfg(...) tables of the same keys; usually [platform.build]"
        },
        {
          "key": "carrier",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "{ package, section, main }: the program mcpp pack builds of a loaded artifact for a system (all three required)"
        },
        {
          "key": "hosted",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "what a host triple takes when it selects the platform: targets, toolchain, layers"
        },
        {
          "key": "layers",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "<layer> = <package> | false for kernel-abi, c-abi, c++-abi, compiler-runtime; usually [platform.layers]"
        },
        {
          "key": "link",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "driver, flags, start, script, inputs, exe, shared, seal; usually [platform.link]"
        },
        {
          "key": "plugin",
          "type": "enum",
          "values": [
            "build.mcpp"
          ],
          "since": "2026.10.27.1",
          "note": "the package's build program, run in the platform phase; no other value is accepted"
        },
        {
          "key": "runner",
          "type": "array",
          "since": "2026.10.27.1",
          "note": "how mcpp run and mcpp test start an artifact: an argv with {} for the artifact, or { cmd, host = \"same-arch\" | \"any\", exclusive }"
        },
        {
          "key": "runners",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "named device actions, <name> = [argv]"
        },
        {
          "key": "sysroot",
          "type": "string",
          "since": "2026.10.27.1",
          "note": "a prebuilt target base, or { path = \"<dir>\", provides = [...] } with path relative to the platform package"
        },
        {
          "key": "targets",
          "type": "array",
          "since": "2026.10.27.1",
          "note": "the target triples the platform serves (required, non-empty)"
        },
        {
          "key": "toolchain",
          "type": "string",
          "since": "2026.10.27.1",
          "note": "the toolchain the targets use, e.g. \"llvm@23.1.3\""
        },
        {
          "key": "tools",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "<name> = <package> | { program = \"<name>\" }: programs built for this machine, or found; usually [platform.tools]"
        },
        {
          "key": "universal",
          "type": "boolean",
          "since": "2026.10.27.1",
          "note": "true: a pack of any of the targets covers all of them in one package (SPEC-014)"
        },
        {
          "key": "versions",
          "type": "table",
          "since": "2026.10.27.1",
          "note": "the version group: <package> = \"<version>\", one version of each package of a family"
        }
      ]
    },
