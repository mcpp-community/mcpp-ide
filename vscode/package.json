{
  "name": "mcpp-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.1",
  "publisher": "mcpp-community",
  "license": "Apache-2.0",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcpp-community/mcpp-ide.git"
  },
  "homepage": "https://github.com/mcpp-community/mcpp-ide#readme",
  "bugs": {
    "url": "https://github.com/mcpp-community/mcpp-ide/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionPack": [
    "sunrisepeak.mcpp-language-server"
  ],
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "mcpp",
    "C++",
    "C++23",
    "modules",
    "build"
  ],
  "activationEvents": [
    "workspaceContains:**/mcpp.toml",
    "onLanguage:mcpp-toml",
    "onDebugResolve:mcpp",
    "onDebugDynamicConfigurations:mcpp"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "mcpp.path",
        "mcpp.ide.backendPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "cpp",
        "filenames": [
          "build.mcpp"
        ]
      },
      {
        "id": "mcpp-toml",
        "aliases": [
          "mcpp TOML",
          "mcpp.toml"
        ],
        "filenames": [
          "mcpp.toml"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mcpp-toml",
        "scopeName": "source.toml.mcpp",
        "path": "./syntaxes/mcpp-toml.tmLanguage.json"
      },
      {
        "scopeName": "source.cpp.mcpp-modules",
        "injectTo": [
          "source.cpp"
        ],
        "path": "./syntaxes/mcpp-modules.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpp",
          "title": "%viewsContainer.mcpp.title%",
          "icon": "media/activity-bar.png"
        }
      ]
    },
    "views": {
      "mcpp": [
        {
          "id": "mcpp.project",
          "name": "%view.mcpp.project.name%",
          "contextualTitle": "%view.mcpp.project.name%",
          "when": "!mcpp.sidebarHidden && mcpp.views.project"
        },
        {
          "id": "mcpp.library",
          "name": "%view.mcpp.library.name%",
          "contextualTitle": "%view.mcpp.library.name%",
          "description": "%view.mcpp.library.description%",
          "type": "webview",
          "when": "!mcpp.sidebarHidden && mcpp.views.library",
          "initialSize": 40
        },
        {
          "id": "mcpp.cache",
          "name": "%view.mcpp.cache.name%",
          "contextualTitle": "%view.mcpp.cache.name%",
          "description": "%view.mcpp.cache.description%",
          "type": "webview",
          "visibility": "collapsed",
          "when": "!mcpp.sidebarHidden && mcpp.views.cache"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "mcpp",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "test",
              "run",
              "clean"
            ],
            "description": "%taskDefinition.mcpp.command%"
          },
          "target": {
            "type": "string",
            "description": "%taskDefinition.mcpp.target%"
          },
          "profile": {
            "type": "string",
            "enum": [
              "dev",
              "release"
            ],
            "description": "%taskDefinition.mcpp.profile%"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%taskDefinition.mcpp.args%"
          },
          "root": {
            "type": "string",
            "description": "%taskDefinition.mcpp.root%"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "mcpp",
        "label": "%debugger.mcpp.label%",
        "languages": [
          "cpp",
          "c"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "target": {
                "type": "string",
                "description": "%debug.mcpp.target%"
              },
              "profile": {
                "type": "string",
                "enum": [
                  "dev",
                  "release"
                ],
                "description": "%debug.mcpp.profile%"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "auto",
                  "cppdbg",
                  "lldb",
                  "lldb-dap",
                  "gdb"
                ],
                "description": "%debug.mcpp.engine%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debug.mcpp.args%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mcpp",
            "request": "launch",
            "name": "mcpp: debug"
          }
        ],
        "configurationSnippets": [
          {
            "label": "mcpp: debug",
            "body": {
              "type": "mcpp",
              "request": "launch",
              "name": "mcpp: debug"
            }
          }
        ]
      }
    ],
    "colors": [
      {
        "id": "mcpp.cacheOkForeground",
        "description": "%colors.mcpp.cacheOkForeground%",
        "defaults": {
          "dark": "#89d185",
          "light": "#388a34",
          "highContrast": "#00ff00"
        }
      },
      {
        "id": "mcpp.cacheStaleForeground",
        "description": "%colors.mcpp.cacheStaleForeground%",
        "defaults": {
          "dark": "#e2c08d",
          "light": "#bf8803",
          "highContrast": "#ffff00"
        }
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.ccm": "cpp",
        "*.cppm": "cpp",
        "*.ixx": "cpp",
        "*.mpp": "cpp"
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "mcpp.test",
          "when": "view == mcpp.project && viewItem == mcppTest",
          "group": "inline@1"
        },
        {
          "command": "mcpp.run",
          "when": "view == mcpp.project && viewItem == mcppExecutable",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "mcpp.build",
          "when": "view == mcpp.project",
          "group": "navigation@1"
        },
        {
          "command": "mcpp.selectTarget",
          "when": "view == mcpp.project",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "gen": "cd .. && mcpp run mcpp-ide-dev -- gen vscode --out vscode/dist/extension --stage",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\" && node --test \"../webui/tests/*.test.js\"",
    "test:e2e": "npm run compile && npm run gen && node out/test/e2e/runTest.js && MCPP_E2E_BUNDLED=1 node out/test/e2e/runTest.js",
    "package": "npm run compile && npm run gen && cd dist/extension && vsce package --no-dependencies -o ../mcpp-vscode-$npm_package_version.vsix",
    "check:webui": "tsc -p ../webui/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^27.0.0",
    "@types/jsdom": "^27.0.0",
    "typescript": "^5.9.0"
  }
}
