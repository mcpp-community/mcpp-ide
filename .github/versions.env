# The versions CI builds and tests with, in one file; .github/actions/setup-mcpp exports them.
# The released mcpp CI installs and uses: it states its features (`features`, the project's mcpp of
# part 2 §4.3), test-launch among them (2026.10.31.2), and builds the backend's ok images on
# openkal-platform 0.18.0. The mock replays the control contract the fixtures were captured from
# (protocol/fixtures/version.txt).
MCPP_VERSION=2026.10.31.2
# A ref of mcpp-community/mcpp CI builds mcpp from and uses instead, for a contract not yet released.
# Empty: the release above is used.
MCPP_SOURCE_REF=
# The LLVM the backend builds with on macOS and Windows (the targets mcpp reaches there with it).
LLVM_VERSION=23.1.3
# The xlings mcpp 2026.10.31.2 bundles, which reads the current index.
XLINGS_VERSION=v2026.10.26.1
# The oldest VS Code the extension supports (engines.vscode), which its tests run in.
VSCODE_VERSION=1.91.0
