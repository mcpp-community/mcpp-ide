# The versions CI builds and tests with, in one file; .github/actions/setup-mcpp exports them.
# The released mcpp CI installs; with MCPP_SOURCE_REF, the one that builds mcpp from that ref.
MCPP_VERSION=2026.10.26.2
# Until mcpp 2026.10.27.1 is released: the ref of mcpp-community/mcpp CI builds and uses, whose control
# contract the fixtures were captured from (protocol/fixtures/version.txt) and whose platforms
# (openkal-platform 0.17.3) the backend's ok images are built on. Empty: the release above is used.
MCPP_SOURCE_REF=release/2026.10.27.1
# The LLVM the backend builds with on macOS and Windows (the targets mcpp reaches there with it).
LLVM_VERSION=23.1.3
# The xlings mcpp 2026.10.26.2 bundles, which reads the current index.
XLINGS_VERSION=v2026.10.26.1
# The oldest VS Code the extension supports (engines.vscode), which its tests run in.
VSCODE_VERSION=1.91.0
